---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from '@/components/media/ProjectMedia.astro';
import { ArrowRight, CircleDot, Folder } from '@lucide/astro';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const { data } = project;
---

<article class:list={['project-card', { featured }]}>
  <ProjectMedia
    src={data.featuredImage}
    alt={data.featuredImageAlt}
    fallbackLabel={`Multimedia de ${data.title} pendiente`}
  />
  <div class="project-body">
    <div class="project-meta">
      <span><CircleDot size={14} aria-hidden="true" />{data.status}</span>
      <span><Folder size={14} aria-hidden="true" />{data.category}</span>
    </div>
    <h3>{data.title}</h3>
    <p>{data.summary}</p>
    <ul class="tag-list" aria-label={`Tecnologías de ${data.title}`}>
      {data.technologies.map((technology) => <li class="tag">{technology}</li>)}
    </ul>
    <a class="text-link" href={`/proyectos/${data.slug}`}
      >Ver caso <ArrowRight class="action-icon" size={17} aria-hidden="true" /></a
    >
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
    overflow: hidden;
    border: 1px solid var(--card-border);
    border-radius: var(--radius-lg);
    background: var(--card-background);
    box-shadow: var(--shadow-sm);
  }
  .project-card :global(.media-placeholder) {
    height: 100%;
    min-height: 400px;
    border: 0;
    border-radius: 0;
  }
  .project-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
  }
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-family: var(--font-utility);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .project-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .project-body h3 {
    margin-bottom: 0.9rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }
  .project-body p {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }
  .project-body .tag-list {
    margin: 0.75rem 0 1.5rem;
  }
  @media (max-width: 800px) {
    .project-card {
      grid-template-columns: 1fr;
    }
    .project-card :global(.media-placeholder) {
      min-height: 0;
    }
    .project-body {
      padding: 1.5rem;
    }
  }
</style>
