---
import siteConfig from '@/config/site.config';
import { AppWindow, Braces, PanelsTopLeft, ShoppingBag, Workflow, Wrench } from '@lucide/astro';

interface Props {
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
const icons = [PanelsTopLeft, Braces, ShoppingBag, AppWindow, Workflow, Wrench];
---

<div class="services-grid">
  {
    siteConfig.services.map((service, index) => {
      const Icon = icons[index];
      return (
        <article class="service-item">
          <span class="service-icon" aria-hidden="true">
            <Icon size={24} stroke-width={1.8} aria-hidden="true" />
          </span>
          <h3>{service.title}</h3>
          <p>{detailed ? service.detail : service.summary}</p>
        </article>
      );
    })
  }
</div>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--divider);
    border-left: 1px solid var(--divider);
  }
  .service-item {
    min-height: 230px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-right: 1px solid var(--divider);
    border-bottom: 1px solid var(--divider);
    background: var(--surface-primary);
  }
  .service-icon {
    display: grid;
    width: 46px;
    height: 46px;
    margin-bottom: 1.75rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-secondary);
    color: var(--brand-secondary);
  }
  .service-item h3 {
    margin-bottom: 0.8rem;
  }
  .service-item p {
    margin: 0;
    color: var(--text-secondary);
  }
  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 580px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .service-item {
      min-height: 0;
    }
  }
</style>
