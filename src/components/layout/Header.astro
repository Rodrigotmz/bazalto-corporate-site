---
import siteConfig from '@/config/site.config';
import { ArrowRight, Menu, Moon, Sun, X } from '@lucide/astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="header-inner container">
    <a class="brand-link" href="/" aria-label="BAZALTO, ir al inicio">
      <img
        class="brand-logo logo-on-light"
        src="/bazalto-logo-horizontal-dark.svg"
        alt="BAZALTO — Software y soluciones digitales"
        width="1546"
        height="505"
      />
      <img
        class="brand-logo logo-on-dark"
        src="/bazalto-logo-horizontal-light.svg"
        alt="BAZALTO — Software y soluciones digitales"
        width="1546"
        height="505"
      />
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        siteConfig.navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Activar tema oscuro"
        aria-pressed="false"
      >
        <Sun class="sun" size={17} stroke-width={1.8} aria-hidden="true" />
        <Moon class="moon" size={17} stroke-width={1.8} aria-hidden="true" />
        <span class="theme-text">Tema oscuro</span>
      </button>
      <a class="header-cta" href="/contacto"
        >Cuéntanos tu proyecto <ArrowRight class="action-icon" size={17} aria-hidden="true" /></a
      >
      <button
        class="menu-trigger"
        type="button"
        aria-label="Abrir menú"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <Menu size={20} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<dialog class="mobile-menu" id="mobile-menu" aria-label="Menú principal">
  <div class="mobile-menu-head">
    <span>Menú</span>
    <button type="button" class="menu-close" data-menu-close aria-label="Cerrar menú">
      <X size={21} aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Navegación móvil">
    {
      siteConfig.navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="mobile-menu-foot">
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-label="Activar tema oscuro"
      aria-pressed="false"
    >
      <Sun class="sun" size={17} stroke-width={1.8} aria-hidden="true" />
      <Moon class="moon" size={17} stroke-width={1.8} aria-hidden="true" />
      <span class="theme-text">Tema oscuro</span>
    </button>
    <a class="button button--primary" href="/contacto"
      >Cuéntanos tu proyecto <ArrowRight class="action-icon" size={18} aria-hidden="true" /></a
    >
  </div>
</dialog>

<script>
  const root = document.documentElement;
  const updateThemeControls = () => {
    const dark = root.dataset.theme === 'dark';
    document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', dark ? 'Activar tema claro' : 'Activar tema oscuro');
      button.setAttribute('aria-pressed', String(dark));
      const text = button.querySelector('.theme-text');
      if (text) text.textContent = dark ? 'Tema claro' : 'Tema oscuro';
    });
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = theme;
      localStorage.setItem('bazalto-theme', theme);
      updateThemeControls();
    });
  });
  updateThemeControls();

  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu');
  const trigger = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const setOpen = (open: boolean) => {
    trigger?.setAttribute('aria-expanded', String(open));
    trigger?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.classList.toggle('menu-open', open);
  };
  trigger?.addEventListener('click', () => {
    dialog?.showModal();
    setOpen(true);
  });
  close?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('cancel', () => setOpen(false));
  dialog
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => dialog.close()));
  dialog?.addEventListener('close', () => {
    setOpen(false);
    trigger?.focus();
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    height: 78px;
    border-bottom: 1px solid var(--header-border);
    background: var(--header-background);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand-link {
    position: relative;
    display: block;
    width: 190px;
    height: 62px;
    flex: 0 0 auto;
  }
  .brand-logo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .logo-on-dark {
    display: none;
  }
  html[data-theme='dark'] .logo-on-light {
    display: none;
  }
  html[data-theme='dark'] .logo-on-dark {
    display: block;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .desktop-nav a {
    position: relative;
    padding-block: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--text-primary);
  }
  .desktop-nav a[aria-current='page']::after {
    position: absolute;
    right: 0;
    bottom: 0.1rem;
    left: 0;
    height: 2px;
    background: var(--brand-secondary);
    content: '';
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .theme-toggle {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-primary);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .theme-toggle:hover,
  .menu-trigger:hover,
  .menu-close:hover {
    border-color: var(--border-strong);
    background: var(--surface-secondary);
    color: var(--text-primary);
  }
  .moon {
    display: none;
  }
  html[data-theme='dark'] .sun {
    display: none;
  }
  html[data-theme='dark'] .moon {
    display: block;
  }
  .header-cta {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--button-primary);
    color: var(--text-inverse);
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
  }
  .header-cta:hover {
    background: var(--button-primary-hover);
    color: var(--text-inverse);
  }
  html[data-theme='dark'] .header-cta {
    color: #101820;
  }
  .menu-trigger {
    display: none;
    width: 44px;
    height: 44px;
    place-content: center;
    gap: 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface-primary);
    color: var(--text-primary);
    cursor: pointer;
  }
  .mobile-menu {
    width: min(100% - 1.5rem, 420px);
    max-height: calc(100dvh - 1.5rem);
    margin: 0.75rem 0.75rem auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--mobile-menu-background);
    color: var(--text-primary);
    box-shadow: var(--shadow-md);
  }
  .mobile-menu::backdrop {
    background: rgba(5, 10, 15, 0.65);
  }
  .mobile-menu-head {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.1rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-utility);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .menu-close {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
  }
  .mobile-menu nav {
    display: grid;
    padding: 1rem;
  }
  .mobile-menu nav a {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--divider);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-menu nav a[aria-current='page']::after {
    color: var(--brand-secondary);
    content: '•';
  }
  .mobile-menu-foot {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }
  .mobile-menu-foot .theme-toggle,
  .mobile-menu-foot .button {
    width: 100%;
  }
  @media (max-width: 1050px) {
    .desktop-nav,
    .header-cta,
    .header-actions > .theme-toggle {
      display: none;
    }
    .menu-trigger {
      display: grid;
    }
  }
  @media (max-width: 420px) {
    .site-header {
      height: 70px;
    }
    .brand-link {
      width: 160px;
      height: 54px;
    }
  }
</style>
