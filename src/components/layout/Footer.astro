---
import siteConfig, { getWhatsAppUrl } from '@/config/site.config';
import { ExternalLink } from '@lucide/astro';

const whatsappUrl = getWhatsAppUrl();
---

<footer class="site-footer">
  <div class="footer-main container">
    <div class="footer-brand">
      <a href="/" aria-label="BAZALTO, ir al inicio">
        <img
          src="/bazalto-logo-horizontal-light.svg"
          alt="BAZALTO — Software y soluciones digitales"
          width="1546"
          height="505"
        />
      </a>
      <p>{siteConfig.descriptor}</p>
    </div>
    <nav aria-label="Navegación del pie de página">
      {siteConfig.footerNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="footer-contact">
      <p class="footer-label">Contacto</p>
      <a href={siteConfig.facebook.url} target="_blank" rel="noopener noreferrer"
        >Facebook de BAZALTO <ExternalLink size={14} aria-hidden="true" /></a
      >
      {
        whatsappUrl ? (
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            WhatsApp <ExternalLink size={14} aria-hidden="true" />
          </a>
        ) : (
          <span class="disabled-channel" aria-disabled="true">
            WhatsApp próximamente
          </span>
        )
      }
    </div>
  </div>
  <div class="footer-bottom container">
    <p>© {new Date().getFullYear()} BAZALTO. Software y soluciones digitales.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    background: var(--footer-background);
    color: var(--footer-text);
  }
  .footer-main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }
  .footer-brand img {
    width: 230px;
    height: auto;
  }
  .footer-brand p {
    margin: 0.75rem 0 0;
    color: var(--footer-text);
    font-size: 0.9rem;
  }
  .site-footer nav,
  .footer-contact {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }
  .site-footer a {
    color: var(--footer-text);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .site-footer a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
  .footer-label {
    margin: 0 0 0.15rem;
    color: #ffffff;
    font-family: var(--font-utility);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .disabled-channel {
    color: #8796a5;
    font-size: 0.9rem;
  }
  .footer-bottom {
    padding-block: 1.25rem;
    border-top: 1px solid #263441;
  }
  .footer-bottom p {
    margin: 0;
    color: #93a2b0;
    font-size: 0.78rem;
  }
  @media (max-width: 720px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-brand img {
      width: 210px;
    }
  }
</style>
