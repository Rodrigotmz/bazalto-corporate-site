---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no existe o cambió de ubicación."
  noindex
>
  <section class="not-found">
    <div class="not-found-grid container">
      <p class="code" aria-hidden="true">404</p>
      <div>
        <p class="eyebrow">Página no encontrada</p><h1>
          Esta ruta no lleva a una página disponible.
        </h1><p class="lead">
          Puede que la dirección haya cambiado o que el enlace no sea correcto.
        </p><a class="button button--primary" href="/">Volver al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 70svh;
    align-items: center;
    padding-block: 4rem;
  }
  .not-found-grid {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    align-items: center;
    gap: clamp(2rem, 8vw, 8rem);
  }
  .code {
    margin: 0;
    color: var(--brand-secondary);
    font-family: var(--font-utility);
    font-size: clamp(5rem, 15vw, 12rem);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.08em;
  }
  .not-found h1 {
    margin-bottom: 1.25rem;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
  }
  .not-found .lead {
    margin-bottom: 2rem;
  }
  @media (max-width: 680px) {
    .not-found-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
